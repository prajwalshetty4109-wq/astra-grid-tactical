# CampusFix — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Required for AI triage, multimodal image analysis, duplicate detection,
# explainable priority scoring, and 60-second maintenance action brief generation.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key-here

# ─── Supabase (Optional) ─────────────────────────────────────────────────────
# CampusFix operates fully with all 36 pre-seeded reports using an in-memory
# fallback store even if Supabase is not configured. Configure these for
# persistent cross-session data storage.
# Get your keys at: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
